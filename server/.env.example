##############################################################################
# AFIRMATIVE PILL · Configuracion del backend
#
# 1. Copia este archivo a `.env` (en esta misma carpeta `server/`).
# 2. Rellena DATABASE_URL con la cadena de tu proyecto de Supabase.
# 3. `.env` esta en .gitignore: NUNCA subas tus credenciales al repositorio.
##############################################################################

# --- Supabase / PostgreSQL --------------------------------------------------
# Donde encontrarla:
#   Supabase → tu proyecto → boton "Connect" (arriba) → pestana "ORMs/Drivers"
#
# Usa la opcion "Session pooler" (puerto 5432 en el host ...pooler.supabase.com):
# es compatible con IPv4, que es lo que tiene la mayoria de redes domesticas,
# y admite transacciones, que este proyecto necesita para reservar inventario.
#
# Sustituye [YOUR-PASSWORD] por la contrasena de la base de datos que definiste
# al crear el proyecto. Si la contrasena tiene caracteres especiales (@ : / ? #)
# hay que codificarlos en porcentaje: @ -> %40, # -> %23, / -> %2F.
DATABASE_URL=postgresql://postgres.tuproyecto:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Servidor ---------------------------------------------------------------
PORT=4000

# Origenes del frontend autorizados por CORS (separados por comas).
# 5173 = `npm run dev` de Vite · 4173 = `npm run preview`.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Autenticacion ----------------------------------------------------------
# Secreto con el que se firman los JWT que emite la mutation `signIn`.
# En un despliegue real seria una cadena aleatoria larga y secreta.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=12h

# --- CQRS · Consistencia eventual -------------------------------------------
# Retardo artificial del proyector, en milisegundos.
#
# En produccion valdria 0: la proyeccion se reconstruye al instante y el
# desfase es imperceptible. Lo subimos a 1500 ms para que durante la
# demostracion se pueda VER el estado "sincronizando" en la interfaz, que es
# justo lo que el taller pide contemplar.
# Sugerencia: subelo a 2500 mientras grabas, para que el banner de
# "sincronizando" se vea con holgura en el video.
PROJECTION_DELAY_MS=1500

# Cada cuanto el poller del outbox recupera eventos que quedaron sin proyectar.
OUTBOX_POLL_INTERVAL_MS=5000

# --- Observabilidad ---------------------------------------------------------
# true = imprime cada consulta SQL en consola.
# Dejalo en true para grabar el video: es la evidencia de que el DataLoader
# agrupa N consultas en una sola operacion en lote.
LOG_SQL=true
